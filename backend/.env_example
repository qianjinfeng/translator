# Medical Document Translator — Environment Variables
# Copy this file to .env and fill in values as needed.
#   cp .env_example .env
# All variables are optional; defaults work for local dev with MockProvider.

# --- App ---
# APP_NAME=Medical Document Translator
# DEBUG=true

# --- Database ---
# DATABASE_URL=sqlite:///./data/translator.db

# --- Ollama (local AI) ---
# Default (Docker): http://ollama:11434
# Local without Docker: http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:14b

# --- Cloud AI (optional) ---
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPL_API_KEY=your-deepl-api-key

# --- File Storage ---
# UPLOAD_DIR=./data/uploads
# OUTPUT_DIR=./data/outputs

# --- RAG Translation Memory ---
# RAG_ENABLED_BY_DEFAULT=false
# RAG_SIMILARITY_THRESHOLD=0.85
# RAG_MAX_EXAMPLES=5

# --- Image Translation ---
# IMAGE_TRANSLATION_ENABLED_BY_DEFAULT=false

# --- Limits ---
# MAX_UPLOAD_SIZE_MB=50
# TRANSLATION_TIMEOUT_SECONDS=300
